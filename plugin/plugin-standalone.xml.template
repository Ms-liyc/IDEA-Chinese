<idea-plugin allow-bundled-update="true">
  <id>{{PLUGIN_ID}}</id>
  <version>{{VERSION}}</version>
  <idea-version since-build="{{MIN_BUILD}}"/>
  <name>{{PLUGIN_NAME}}</name>
  <vendor url="{{VENDOR_URL}}" email="{{VENDOR_EMAIL}}">{{VENDOR}}</vendor>
  <category>Language Pack</category>

  <description><![CDATA[
<div style="text-align: center;">
  <img src="https://raw.githubusercontent.com/Ms-liyc/IDEA-Chinese/main/plugin/assets/logo.png" alt="屿宸网络科技工作室" width="360"/>
</div>

<h2 style="text-align: center;">IntelliJ IDEA 独立简体中文语言包</h2>

<p style="text-align: center;">
  全量扫描 IDEA 界面 NLS 字符串，<b>不依赖 JetBrains 官方中文扩展</b>。<br/>
  安装后可将菜单、设置、检查项、意图动作与工具窗口切换为简体中文。
</p>

<p style="text-align: center;">
  <b>✨ 当前版本 {{VERSION}}</b><br/>
  <span style="color: gray;">IDEA 2024.2+ · 独立 Language Pack · 约 12 万条 UI 字符串</span>
</p>

<h3>🌟 项目亮点</h3>
<ul>
  <li><b>🎯 全量汉化</b> — 扫描 <code>lib/</code> 与 <code>plugins/</code> 全部模块 JAR，覆盖 messages / inspection / intention / templates</li>
  <li><b>🔒 独立安装</b> — 不依赖官方中文扩展，普通用户权限即可，不写安装目录</li>
  <li><b>🌏 完整资源</b> — 覆盖 7,466 个资源文件、124,000+ 条 UI 字符串</li>
  <li><b>⚡ 安装即用</b> — 运行 <code>install-standalone.ps1</code>，在「语言与区域」选择简体中文（独立版）</li>
  <li><b>📊 缺口可视</b> — 配套 <code>l10n report</code> 工具，待译条目一目了然</li>
  <li><b>📜 持续维护</b> — 屿宸网络科技工作室 / IDEA 汉化组</li>
</ul>

<table cellpadding="4" cellspacing="0">
  <tr>
    <td bgcolor="#007ec6"><font color="#ffffff"><b>&nbsp;version&nbsp;</b></font></td>
    <td bgcolor="#007ec6"><font color="#ffffff">&nbsp;{{VERSION}}&nbsp;</font></td>
