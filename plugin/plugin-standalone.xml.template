    <td bgcolor="#555"><font color="#ffffff">&nbsp;MIT&nbsp;</font></td>
  </tr>
  <tr>
    <td bgcolor="#fe7d37"><font color="#ffffff"><b>&nbsp;locale&nbsp;</b></font></td>
    <td bgcolor="#fe7d37"><font color="#ffffff">&nbsp;zh-CN&nbsp;</font></td>
    <td bgcolor="#007ec6">&nbsp;</td>
    <td bgcolor="#007ec6"><font color="#ffffff"><b>&nbsp;IDEA&nbsp;</b></font></td>
    <td bgcolor="#007ec6"><font color="#ffffff">&nbsp;2024.2+&nbsp;</font></td>
