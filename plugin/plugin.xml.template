<idea-plugin>
  <id>{{PLUGIN_ID}}</id>
  <name>{{PLUGIN_NAME}}</name>
  <vendor url="{{VENDOR_URL}}" email="{{VENDOR_EMAIL}}">{{VENDOR}}</vendor>
  <version>{{VERSION}}</version>

  <description><![CDATA[
<div style="text-align: center;">
  <img src="assets/logo.png" alt="屿宸网络科技工作室" width="360"/>
</div>

<h2 style="text-align: center;">IntelliJ IDEA 简体中文语言包</h2>

<p style="text-align: center;">
  全量扫描 IDEA 界面 NLS 字符串，合并官方中文基线与社区增量翻译。<br/>
  安装后可将菜单、设置、检查项、意图动作与工具窗口切换为简体中文。
</p>

<p style="text-align: center;">
  <b>✨ 当前版本 {{VERSION}}</b><br/>
  <span style="color: gray;">IDEA 2024.2+ · Language Pack · 约 12 万条基线 + 社区补齐词条</span>
</p>

<h3>🌟 项目亮点</h3>
<ul>
  <li><b>🎯 全量汉化</b> — 扫描 <code>lib/</code> 与 <code>plugins/</code> 全部模块 JAR，覆盖 messages / inspection / intention / templates</li>
  <li><b>🔒 零侵入安装</b> — 纯语言包插件，不写 IDE 安装目录，无需管理员权限</li>
  <li><b>🌏 官方基线</b> — 基于 <code>localization-zh.jar</code> 增量补齐，避免从零翻译</li>
  <li><b>⚡ 安装即用</b> — 启用插件并在「语言与区域」选择简体中文，重启 IDE 生效</li>
  <li><b>📊 缺口可视</b> — 配套 <code>l10n report</code> 工具，待译条目一目了然</li>
  <li><b>📜 持续维护</b> — 屿宸网络科技工作室 / IDEA 汉化组</li>
</ul>

